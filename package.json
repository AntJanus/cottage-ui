{
  "visibility": "public",
  "name": "@antjanus/cottage-ui",
  "version": "2.0.0",
  "description": "React component library with cottage-style UI primitives for consistent, accessible interfaces.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antjanus/cottage-ui.git"
  },
  "homepage": "https://github.com/antjanus/cottage-ui#readme",
  "bugs": {
    "url": "https://github.com/antjanus/cottage-ui/issues"
  },
  "license": "MIT",
  "author": "Antonin Januska",
  "main": "./dist/cottage-ui.umd.cjs",
  "module": "./dist/cottage-ui.js",
  "types": "./dist/cottage-ui.d.ts",
  "style": "./dist/cottage-ui.css",
  "exports": {
    ".": {
      "types": "./dist/cottage-ui.d.ts",
      "import": "./dist/cottage-ui.js",
      "require": "./dist/cottage-ui.umd.cjs"
    },
    "./dist/cottage-ui.css": "./dist/cottage-ui.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "prebuild": "rm -rf dist",
    "build": "tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.0.18",
    "vite-tsconfig-paths": "^6.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@storybook/addon-docs": "^10.2.8",
    "@storybook/addon-links": "^10.2.8",
    "@storybook/addon-onboarding": "^10.2.8",
    "@storybook/react": "^10.2.8",
    "@storybook/react-vite": "^10.2.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-storybook": "^10.2.8",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.6",
    "semantic-release": "^24.2.9",
    "storybook": "^10.2.8",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  }
}
